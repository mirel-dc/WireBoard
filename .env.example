# Optional host port. The container always listens on 9843.
WIREBOARD_PORT=9843
# just and Compose both read this file. An environment variable takes precedence.
# Without WIREBOARD_DATA_DIR, just uses the native library's default directory.
# Set an absolute shared folder to use another library:
# WIREBOARD_DATA_DIR=C:/Users/your-name/AppData/Local/Wireboard
# On Linux also use your host user's UID/GID (id -u / id -g).
