# Optional host port. The container always listens on 9843.
WIREBOARD_PORT=9843
# just resolves the same directory as the native binary automatically.
# For direct docker compose, set the absolute path explicitly:
# WIREBOARD_DATA_DIR=C:/Users/your-name/AppData/Local/Wireboard
# On Linux also use your host user's UID/GID (id -u / id -g).
